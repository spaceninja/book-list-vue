  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "serve": "vite preview",
    "lint": "run-s lint:js lint:css lint:prettier",
    "lint:check": "run-s lint:*:check",
    "lint:js": "eslint '**/*.{js,vue}' --fix",
    "lint:js:check": "eslint '**/*.{js,vue}'",
    "lint:css": "stylelint --fix '**/*.{css,scss,vue}'",
    "lint:css:check": "stylelint '**/*.{css,scss,vue}'",
    "lint:prettier": "prettier . --write",
    "lint:prettier:check": "prettier . --check",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "firebase": "13.1.0",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/user-event": "14.6.8",
    "@testing-library/vue": "8.1.0",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/compiler-sfc": "3.5.44",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.11.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "npm-run-all2": "9.0.4",
    "postcss-html": "2.0.0",
    "prettier": "3.9.10",
    "sass": "1.106.1",
    "stylelint": "17.16.0",
    "stylelint-config-recommended-vue": "2.0.0",
    "stylelint-config-spaceninja": "17.0.0",
    "thenby": "1.4.1",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vue-eslint-parser": "10.4.1"
  }
}
